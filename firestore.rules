rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function connecte() { return request.auth != null; }
    function admin() {
      return connecte() && request.auth.token.email == 'denahoueamerveil@gmail.com' && request.auth.token.email_verified == true;
    }
    function fiche() { return /databases/$(database)/documents/members/$(request.auth.uid); }
    function valide() {
      return admin() || (connecte() && exists(fiche()) && get(fiche()).data.status == 'approved');
    }

    match /members/{uid} {
      allow read: if valide() || (connecte() && request.auth.uid == uid);
      allow create: if connecte() && request.auth.uid == uid && (
        admin() ||
        (request.resource.data.status == 'pending'
          && request.resource.data.keys().hasOnly(['uid', 'name', 'email', 'joined', 'warnings', 'badges', 'status', 'notified'])
          && request.resource.data.email == request.auth.token.email
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
          && request.resource.data.badges.size() == 0 && request.resource.data.warnings.size() == 0)
      );
      allow update, delete: if admin();
    }

    match /posts/{id} {
      allow read: if valide();
      allow create: if valide() && request.resource.data.uid == request.auth.uid
        && request.resource.data.type in ['objectif', 'matin', 'jour', 'semaine', 'message']
        && request.resource.data.ts is int
        && request.resource.data.ts <= request.time.toMillis() + 600000
        && (!('text' in request.resource.data) || request.resource.data.text.size() <= 1000)
        && (!('photo' in request.resource.data) || request.resource.data.photo.size() <= 400000)
        && (!('items' in request.resource.data) || request.resource.data.items.size() <= 8)
        && (!('objText' in request.resource.data) || request.resource.data.objText.size() <= 1500)
        && (!('prog' in request.resource.data) || request.resource.data.prog.size() <= 9)
        && (!('progPhoto' in request.resource.data) || request.resource.data.progPhoto.size() <= 400000)
        && (!('tasks' in request.resource.data) || request.resource.data.tasks.size() <= 80)
        && (!('photos' in request.resource.data) || admin())
        && (!('video' in request.resource.data) || admin());
      // J'aime : chacun ne peut ajouter ou retirer que son propre j'aime
      allow update: if admin() || (valide()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
        && request.resource.data.likes.toSet().difference(resource.data.get('likes', []).toSet()).hasOnly([request.auth.uid])
        && resource.data.get('likes', []).toSet().difference(request.resource.data.likes.toSet()).hasOnly([request.auth.uid]));
      allow delete: if admin() || (valide() && resource.data.uid == request.auth.uid);
    }

    match /comments/{id} {
      allow read: if valide();
      allow create: if valide() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['postId', 'uid', 'name', 'text', 'ts'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500
        && request.resource.data.ts is int && request.resource.data.ts <= request.time.toMillis() + 600000;
      allow delete: if admin() || (valide() && resource.data.uid == request.auth.uid);
    }

    // Vidéos découpées en morceaux (publiées par l'administrateur)
    match /media/{id} {
      allow read: if valide();
      allow write: if admin();
      match /parts/{n} {
        allow read: if valide();
        allow write: if admin();
      }
    }

    match /tokens/{token} {
      allow create, update: if connecte() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if false;
    }
    // Mon Argent : chaque utilisateur ne voit que ses propres données
    match /users/{uid} {
      allow read, write: if connecte() && request.auth.uid == uid;
      match /{document=**} {
        allow read, write: if connecte() && request.auth.uid == uid;
      }
    }
    match /argentTokens/{token} {
      allow create, update: if connecte() && request.resource.data.uid == request.auth.uid;
      allow read, delete: if false;
    }
  }
}
